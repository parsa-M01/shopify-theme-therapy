</style>


<script>

  (() => {

    const root = document.querySelector(
      '.tl-product[data-section-id="{{ section.id }}"]'
    );

    if (!root) return;


    /* ===================================================
       PRODUCT VARIANTS
    =================================================== */

    const productData = {{ product | json }};

    const form = root.querySelector('#tl-product-form');

    const variantInput =
      root.querySelector('[data-variant-id]');

    const priceElement =
      root.querySelector('[data-price]');

    const stickyPrice =
      root.querySelector('[data-sticky-price]');

    const addButton =
      root.querySelector('[data-add-button]');

    const addLabel =
      root.querySelector('[data-add-label]');


    let selectedOptions =
      productData.selected_or_first_available_variant
        ? productData.selected_or_first_available_variant.options
        : [];


    function formatMoney(cents) {

      const moneyFormat =
        {{ shop.money_format | json }};

      if (window.Shopify &&
          typeof Shopify.formatMoney === 'function') {

        return Shopify.formatMoney(
          cents,
          moneyFormat
        );

      }

      return '$' + (cents / 100).toFixed(2);

    }


    function findVariant() {

      return productData.variants.find(
        variant => {

          return variant.options.every(
            (option, index) => {

              return option === selectedOptions[index];

            }
          );

        }
      );

    }


    function updateVariant() {

      const variant = findVariant();

      if (!variant) {

        if (addButton) {
          addButton.disabled = true;
        }

        return;

      }


      selectedOptions =
        variant.options;


      if (variantInput) {

        variantInput.value =
          variant.id;

      }


      if (priceElement) {

        priceElement.innerHTML =
          formatMoney(variant.price);

      }


      if (stickyPrice) {

        stickyPrice.innerHTML =
          formatMoney(variant.price);

      }


      if (addButton) {

        addButton.disabled =
          !variant.available;

      }


      if (addLabel) {

        addLabel.textContent =
          variant.available
            ? 'Book this session'
            : 'Sold out';

      }


      /* UPDATE SELECTED BUTTONS */

      root
        .querySelectorAll('.tl-option-button')
        .forEach(button => {

          const position =
            Number(
              button.dataset.optionPosition
            ) - 1;

          const value =
            button.dataset.optionValue;

          button.classList.toggle(
            'is-selected',
            selectedOptions[position] === value
          );

        });


      /* UPDATE IMAGE */

      if (variant.featured_image) {

        const imageUrl =
          variant.featured_image
            .src
            .replace(
              /(\.[^./?]+)(\?.*)?$/,
              '_1400x$1$2'
            );

        const image =
          root.querySelector(
            '.tl-main-product-image'
          );

        if (image) {

          image.src =
            imageUrl;

        }

      }

    }


    /* OPTION BUTTONS */

    root
      .querySelectorAll('.tl-option-button')
      .forEach(button => {

        button.addEventListener(
          'click',
          () => {

            const position =
              Number(
                button.dataset.optionPosition
              ) - 1;

            selectedOptions[position] =
              button.dataset.optionValue;

            updateVariant();

          }
        );

      });


    /* ===================================================
       THUMBNAILS
    =================================================== */

    const mainImage =
      root.querySelector(
        '.tl-main-product-image'
      );


    root
      .querySelectorAll('.tl-thumbnail')
      .forEach(thumbnail => {

        thumbnail.addEventListener(
          'click',
          () => {

            if (!mainImage) return;

            const image =
              thumbnail.dataset.image;

            mainImage.style.opacity = '0';


            setTimeout(() => {

              mainImage.src =
                image;

              mainImage.style.opacity = '1';

            }, 150);


            root
              .querySelectorAll('.tl-thumbnail')
              .forEach(item => {

                item.classList.remove(
                  'is-active'
                );

              });


            thumbnail.classList.add(
              'is-active'
            );

          }
        );

      });


    /* ===================================================
       QUANTITY
    =================================================== */

    const quantity =
      root.querySelector(
        '[data-quantity]'
      );


    const minus =
      root.querySelector(
        '[data-quantity-minus]'
      );


    const plus =
      root.querySelector(
        '[data-quantity-plus]'
      );


    if (minus && quantity) {

      minus.addEventListener(
        'click',
        () => {

          const value =
            Math.max(
              1,
              Number(quantity.value) - 1
            );

          quantity.value =
            value;

        }
      );

    }


    if (plus && quantity) {

      plus.addEventListener(
        'click',
        () => {

          quantity.value =
            Number(quantity.value) + 1;

        }
      );

    }


    /* ===================================================
       FAQ
    =================================================== */

    root
      .querySelectorAll('.tl-faq-question')
      .forEach(button => {

        button.addEventListener(
          'click',
          () => {

            const item =
              button.closest(
                '.tl-faq-item'
              );


            root
              .querySelectorAll('.tl-faq-item')
              .forEach(other => {

                if (other !== item) {

                  other.classList.remove(
                    'is-open'
                  );

                }

              });


            item.classList.toggle(
              'is-open'
            );

          }
        );

      });


    /* ===================================================
       STICKY BUY
    =================================================== */

    const sticky =
      root.querySelector(
        '[data-sticky-buy]'
      );


    const stickyButton =
      root.querySelector(
        '[data-sticky-button]'
      );


    const heroForm =
      root.querySelector(
        '#tl-product-form'
      );


    if (sticky && heroForm) {

      const observer =
        new IntersectionObserver(
          entries => {

            const entry =
              entries[0];

            sticky.classList.toggle(
              'is-visible',
              !entry.isIntersecting
            );

          },
          {
            threshold: 0
          }
        );


      observer.observe(
        heroForm
      );

    }


    if (stickyButton && heroForm) {

      stickyButton.addEventListener(
        'click',
        () => {

          heroForm.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

        }
      );

    }


    /* INITIAL VARIANT */

    updateVariant();

  })();

</script>


