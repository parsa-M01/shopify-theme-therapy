{% liquid
  assign current_product = product
  assign current_variant = product.selected_or_first_available_variant
%}

<section
  class="tl-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>

  <!-- =====================================================
       PRODUCT HERO
  ====================================================== -->

  <div class="tl-product-container">

    <div class="tl-product-grid">

      <!-- =================================================
           LEFT — MEDIA
      ================================================== -->

      <div class="tl-product-media">

        {% if product.featured_image %}

          <div class="tl-main-image-wrap">

            <div class="tl-image-label">
              100% HUMAN
            </div>

            <div class="tl-main-image">

              {% assign first_image = product.featured_image %}

              {{
                first_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  class: 'tl-main-product-image',
                  alt: first_image.alt | default: product.title
              }}

            </div>

          </div>

        {% else %}

          <div class="tl-image-placeholder">

            <span>
              therapy<span>lane</span>
            </span>

          </div>

        {% endif %}


        {% if product.images.size > 1 %}

          <div class="tl-thumbnails">

            {% for image in product.images %}

              <button
                type="button"
                class="tl-thumbnail {% if forloop.first %}is-active{% endif %}"
                data-image="{{ image | image_url: width: 1400 }}"
                aria-label="View image {{ forloop.index }}"
              >

                {{
                  image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    alt: image.alt | default: product.title
                }}

              </button>

            {% endfor %}

          </div>

        {% endif %}

      </div>


      <!-- =================================================
           RIGHT — PRODUCT INFORMATION
      ================================================== -->

      <div class="tl-product-info">

        <div class="tl-product-eyebrow">

          <span>
            {% if product.type != blank %}
              {{ product.type }}
            {% else %}
              THERAPY SESSION
            {% endif %}
          </span>

          <span class="tl-product-number">
            01 · HUMAN
          </span>

        </div>


        <h1 class="tl-product-title">
          {{ product.title }}
        </h1>


        <div class="tl-product-intro">

          {% if product.description != blank %}

            {{ product.description
              | strip_html
              | truncatewords: 34
            }}

          {% else %}

            Real human therapy with someone qualified,
            present, and genuinely here to listen.

          {% endif %}

        </div>


        <!-- PRICE -->

        <div class="tl-product-price-wrap">

          <div
            class="tl-product-price"
            data-price
          >
            {{ current_variant.price | money }}
          </div>

          <span class="tl-price-suffix">
            / session
          </span>

        </div>


        <!-- TRUST POINTS -->

        <div class="tl-trust-list">

          <div class="tl-trust-item">

            <span class="tl-check">
              ✓
            </span>

            <span>
              Real human therapist
            </span>

          </div>


          <div class="tl-trust-item">

            <span class="tl-check">
              ✓
            </span>

            <span>
              Private 1:1 session
            </span>

          </div>


          <div class="tl-trust-item">

            <span class="tl-check">
              ✓
            </span>

            <span>
              No AI therapy
            </span>

          </div>

        </div>


        <!-- =================================================
             PURCHASE AREA
        ================================================== -->

        {% form 'product',
          product,
          id: 'tl-product-form',
          class: 'tl-product-form'
        %}

          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            data-variant-id
          >


          {% unless product.has_only_default_variant %}

            <div class="tl-options">

              {% for option in product.options_with_values %}

                <div class="tl-option">

                  <label class="tl-option-label">

                    {{ option.name }}

                  </label>


                  <div class="tl-option-values">

                    {% for value in option.values %}

                      {% liquid
                        assign option_available = false

                        for variant in product.variants
                          if variant.available
                            if option.position == 1 and variant.option1 == value
                              assign option_available = true
                            elsif option.position == 2 and variant.option2 == value
                              assign option_available = true
                            elsif option.position == 3 and variant.option3 == value
                              assign option_available = true
                            endif
                          endif
                        endfor
                      %}

                      <button
                        type="button"
                        class="tl-option-button {% if option.selected_value == value %}is-selected{% endif %}"
                        data-option-position="{{ option.position }}"
                        data-option-value="{{ value | escape }}"
                        {% unless option_available %}
                          disabled
                        {% endunless %}
                      >

                        {{ value }}

                      </button>

                    {% endfor %}

                  </div>

                </div>

              {% endfor %}

            </div>

          {% endunless %}


          <!-- QUANTITY -->

          <div class="tl-quantity-row">

            <label>
              Quantity
            </label>

            <div class="tl-quantity">

              <button
                type="button"
                data-quantity-minus
                aria-label="Decrease quantity"
              >
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-quantity
              >

              <button
                type="button"
                data-quantity-plus
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>

          </div>


          <!-- ADD TO CART -->

          <button
            type="submit"
            class="tl-add-button"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
            data-add-button
          >

            <span data-add-label>

              {% if current_variant.available %}
                Book this session
              {% else %}
                Sold out
              {% endif %}

            </span>

            <span class="tl-arrow">
              ↗
            </span>

          </button>


          <div class="tl-secure-note">

            <span class="tl-secure-dot"></span>

            Private conversation · Human therapist · No AI

          </div>

        {% endform %}

      </div>

    </div>

  </div>


  <!-- =====================================================
       TRUST SECTION
  ====================================================== -->

  <section class="tl-trust-section">

    <div class="tl-container">

      <div class="tl-section-kicker">
        WHY THERAPY LANE
      </div>

      <h2 class="tl-section-title">
        You don't need<br>
        another algorithm.
      </h2>


      <div class="tl-trust-grid">

        <article class="tl-trust-card">

          <span class="tl-card-number">
            01
          </span>

          <div class="tl-card-icon">
            ✦
          </div>

          <h3>
            Actually human
          </h3>

          <p>
            Your session is with a real therapist.
            No bot pretending to understand you.
          </p>

        </article>


        <article class="tl-trust-card tl-trust-card-dark">

          <span class="tl-card-number">
            02
          </span>

          <div class="tl-card-icon">
            ◌
          </div>

          <h3>
            Private by design
          </h3>

          <p>
            One-on-one conversations focused on you,
            your experience, and what you want to work through.
          </p>

        </article>


        <article class="tl-trust-card">

          <span class="tl-card-number">
            03
          </span>

          <div class="tl-card-icon">
            +
          </div>

          <h3>
            Professional support
          </h3>

          <p>
            Choose the therapist experience level
            that feels right for you.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================================
       HOW IT WORKS
  ====================================================== -->

  <section class="tl-how">

    <div class="tl-container">

      <div class="tl-section-kicker">
        SIMPLE BY DESIGN
      </div>

      <h2 class="tl-section-title">
        Three steps.<br>
        No weirdness.
      </h2>


      <div class="tl-steps">

        <article class="tl-step">

          <span class="tl-step-number">
            01
          </span>

          <h3>
            Choose a human
          </h3>

          <p>
            Pick the therapist experience level
            that feels right for you.
          </p>

        </article>


        <article class="tl-step">

          <span class="tl-step-number">
            02
          </span>

          <h3>
            Book your session
          </h3>

          <p>
            Choose a time that works without
            navigating a complicated process.
          </p>

        </article>


        <article class="tl-step">

          <span class="tl-step-number">
            03
          </span>

          <h3>
            Start talking
          </h3>

          <p>
            Show up as yourself.
            Your therapist is there to listen.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- =====================================================
       DESCRIPTION
  ====================================================== -->

  <section class="tl-description">

    <div class="tl-container">

      <div class="tl-description-grid">

        <div>

          <div class="tl-section-kicker">
            ABOUT THIS OPTION
          </div>

          <h2 class="tl-description-title">
            Therapy that feels<br>
            like talking to a person.
          </h2>

        </div>


        <div class="tl-description-copy">

          {% if product.description != blank %}

            {{ product.description }}

          {% else %}

            <p>
              Therapy Lane is built around real human
              connection. Your session gives you space
              to talk, reflect, and work through what's
              actually going on.
            </p>

            <p>
              No automated responses. No AI pretending
              to be a therapist. Just a qualified human
              being there with you.
            </p>

          {% endif %}

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FAQ
  ====================================================== -->

  <section class="tl-faq">

    <div class="tl-container">

      <div class="tl-section-kicker">
        QUESTIONS
      </div>

      <h2 class="tl-section-title">
        No fine-print energy.
      </h2>


      <div class="tl-faq-list">

        <div class="tl-faq-item">

          <button
            type="button"
            class="tl-faq-question"
          >

            <span>
              Is this a real human therapist?
            </span>

            <span class="tl-faq-plus">
              +
            </span>

          </button>

          <div class="tl-faq-answer">

            Yes. Therapy Lane is built around
            real human therapists. There are no
            AI therapists pretending to provide therapy.

          </div>

        </div>


        <div class="tl-faq-item">

          <button
            type="button"
            class="tl-faq-question"
          >

            <span>
              What's included in the session?
            </span>

            <span class="tl-faq-plus">
              +
            </span>

          </button>

          <div class="tl-faq-answer">

            Your session is a private one-on-one
            conversation with a human therapist.

          </div>

        </div>


        <div class="tl-faq-item">

          <button
            type="button"
            class="tl-faq-question"
          >

            <span>
              Can I change therapists?
            </span>

            <span class="tl-faq-plus">
              +
            </span>

          </button>

          <div class="tl-faq-answer">

            If a therapist doesn't feel like the right
            fit, you can choose another available therapist.

          </div>

        </div>


        <div class="tl-faq-item">

          <button
            type="button"
            class="tl-faq-question"
          >

            <span>
              Is my session private?
            </span>

            <span class="tl-faq-plus">
              +
            </span>

          </button>

          <div class="tl-faq-answer">

            Sessions are intended to be private and
            confidential, subject to applicable
            professional and legal requirements.

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FINAL CTA
  ====================================================== -->

  <section class="tl-final">

    <div class="tl-final-inner">

      <div class="tl-final-kicker">
        MAYBE YOU DON'T NEED BETTER AI.
      </div>

      <h2>
        Maybe you just need
        someone real to talk to.
      </h2>

      <p>
        Human-first therapy for real life.
      </p>

      <a
        href="#tl-product-form"
        class="tl-final-button"
      >
        Book your session ↗
      </a>

    </div>

  </section>


  <!-- =====================================================
       STICKY MOBILE / DESKTOP PURCHASE BAR
  ====================================================== -->

  <div
    class="tl-sticky-buy"
    data-sticky-buy
  >

    <div class="tl-sticky-product">

      {% if product.featured_image %}

        {{
          product.featured_image
          | image_url: width: 120
          | image_tag:
            loading: 'lazy',
            alt: product.title
        }}

      {% endif %}

      <div>

        <strong>
          {{ product.title }}
        </strong>

        <small>
          Human therapy session
        </small>

      </div>

    </div>


    <div class="tl-sticky-price">

      <span data-sticky-price>
        {{ current_variant.price | money }}
      </span>

      <small>
        / session
      </small>

    </div>


    <button
      type="button"
      class="tl-sticky-button"
      data-sticky-button
    >
      Book session ↗
    </button>

  </div>


</section>


<style>

  /* =====================================================
     VARIABLES
  ====================================================== */

  .tl-product {
    --tl-green: #173330;
    --tl-green-light: #234944;
    --tl-sage: #8eafa2;
    --tl-mint: #dcebe4;
    --tl-cream: #faf8f1;
    --tl-orange: #f2ad68;
    --tl-white: #ffffff;
    --tl-muted: #6d7d79;
    --tl-line: rgba(23, 51, 48, .10);

    font-family:
      "DM Sans",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    color: var(--tl-green);
    background: var(--tl-cream);

    overflow: hidden;
  }


  .tl-product *,
  .tl-product *::before,
  .tl-product *::after {
    box-sizing: border-box;
  }


  /* =====================================================
     GLOBAL
  ====================================================== */

  .tl-container,
  .tl-product-container {
    width: min(1120px, calc(100% - 32px));
    margin-inline: auto;
  }


  /* =====================================================
     PRODUCT HERO
  ====================================================== */

  .tl-product-container {
    padding: 48px 0 95px;
  }


  .tl-product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, .8fr);
    gap: 70px;
    align-items: start;
  }


  /* =====================================================
     MEDIA
  ====================================================== */

  .tl-product-media {
    min-width: 0;
  }


  .tl-main-image-wrap {
    position: relative;
  }


  .tl-main-image {
    position: relative;

    width: 100%;
    aspect-ratio: 1 / 1.08;

    overflow: hidden;

    background: var(--tl-mint);

    border-radius: 34px;

    box-shadow:
      0 25px 70px rgba(23, 51, 48, .10);
  }


  .tl-main-product-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition:
      opacity .3s ease,
      transform .5s ease;
  }


  .tl-main-image:hover .tl-main-product-image {
    transform: scale(1.025);
  }


  .tl-image-label {
    position: absolute;

    top: 18px;
    left: 18px;

    z-index: 3;

    padding: 8px 12px;

    background: rgba(255, 255, 255, .88);

    border: 1px solid rgba(23, 51, 48, .08);

    border-radius: 999px;

    backdrop-filter: blur(14px);

    color: var(--tl-green);

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  .tl-image-placeholder {
    aspect-ratio: 1 / 1.08;

    display: grid;
    place-items: center;

    background: var(--tl-green);

    border-radius: 34px;

    color: white;

    font-family: "Manrope", sans-serif;
    font-size: 34px;
    font-weight: 800;
  }


  .tl-image-placeholder span span {
    color: var(--tl-sage);
  }


  /* =====================================================
     THUMBNAILS
  ====================================================== */

  .tl-thumbnails {
    display: flex;

    gap: 10px;

    margin-top: 12px;

    overflow-x: auto;

    scrollbar-width: none;
  }


  .tl-thumbnails::-webkit-scrollbar {
    display: none;
  }


  .tl-thumbnail {
    flex: 0 0 76px;

    width: 76px;
    height: 76px;

    padding: 0;

    overflow: hidden;

    background: white;

    border: 1px solid var(--tl-line);

    border-radius: 16px;

    cursor: pointer;

    opacity: .58;

    transition:
      opacity .2s ease,
      transform .2s ease,
      border-color .2s ease;
  }


  .tl-thumbnail:hover {
    opacity: 1;

    transform: translateY(-2px);
  }


  .tl-thumbnail.is-active {
    opacity: 1;

    border: 2px solid var(--tl-green);
  }


  .tl-thumbnail img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;
  }


  /* =====================================================
     PRODUCT INFO
  ====================================================== */

  .tl-product-info {
    position: sticky;
    top: 110px;

    padding-top: 18px;
  }


  .tl-product-eyebrow {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding-bottom: 18px;

    border-bottom: 1px solid var(--tl-line);

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.8px;
    text-transform: uppercase;
  }


  .tl-product-eyebrow > span:first-child {
    color: var(--tl-sage);
  }


  .tl-product-number {
    color: var(--tl-muted);

    opacity: .7;
  }


  .tl-product-title {
    margin: 30px 0 15px;

    max-width: 600px;

    font-family: "Manrope", sans-serif;

    font-size: clamp(42px, 5vw, 68px);

    line-height: .98;

    letter-spacing: -2.5px;

    font-weight: 800;
  }


  .tl-product-intro {
    max-width: 510px;

    color: var(--tl-muted);

    font-size: 14px;

    line-height: 1.8;

    letter-spacing: .1px;
  }


  /* =====================================================
     PRICE
  ====================================================== */

  .tl-product-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;

    margin-top: 32px;
  }


  .tl-product-price {
    font-family: "Manrope", sans-serif;

    font-size: 48px;

    font-weight: 800;

    letter-spacing: -1.8px;

    line-height: 1;
  }


  .tl-price-suffix {
    color: var(--tl-muted);

    font-size: 11px;
  }


  /* =====================================================
     TRUST LIST
  ====================================================== */

  .tl-trust-list {
    display: grid;

    gap: 9px;

    margin-top: 26px;
  }


  .tl-trust-item {
    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 11px;
  }


  .tl-check {
    width: 19px;
    height: 19px;

    display: grid;
    place-items: center;

    flex: none;

    background: var(--tl-mint);

    border-radius: 50%;

    color: var(--tl-green);

    font-size: 9px;
    font-weight: 900;
  }


  /* =====================================================
     FORM
  ====================================================== */

  .tl-product-form {
    margin-top: 30px;
  }


  /* =====================================================
     OPTIONS
  ====================================================== */

  .tl-options {
    display: grid;

    gap: 22px;

    margin-bottom: 26px;
  }


  .tl-option {
    display: grid;

    gap: 10px;
  }


  .tl-option-label {
    font-size: 10px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 1.3px;
  }


  .tl-option-values {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;
  }


  .tl-option-button {
    min-height: 44px;

    padding: 0 17px;

    background: white;

    border: 1px solid var(--tl-line);

    border-radius: 13px;

    color: var(--tl-green);

    font-family: inherit;

    font-size: 12px;

    font-weight: 600;

    cursor: pointer;

    transition:
      background .2s ease,
      color .2s ease,
      border-color .2s ease,
      transform .2s ease;
  }


  .tl-option-button:hover {
    transform: translateY(-1px);

    border-color: var(--tl-green);
  }


  .tl-option-button.is-selected {
    background: var(--tl-green);

    border-color: var(--tl-green);

    color: white;
  }


  .tl-option-button:disabled {
    cursor: not-allowed;

    opacity: .35;

    text-decoration: line-through;
  }


  /* =====================================================
     QUANTITY
  ====================================================== */

  .tl-quantity-row {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 14px;
  }


  .tl-quantity-row > label {
    font-size: 10px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 1.3px;
  }


  .tl-quantity {
    display: flex;

    align-items: center;

    overflow: hidden;

    background: white;

    border: 1px solid var(--tl-line);

    border-radius: 13px;
  }


  .tl-quantity button {
    width: 38px;
    height: 38px;

    border: 0;

    background: transparent;

    color: var(--tl-green);

    font-size: 18px;

    cursor: pointer;
  }


  .tl-quantity input {
    width: 38px;
    height: 38px;

    padding: 0;

    border: 0;

    outline: 0;

    background: transparent;

    color: var(--tl-green);

    text-align: center;

    font-family: inherit;

    font-size: 12px;

    font-weight: 700;
  }


  /* =====================================================
     ADD BUTTON
  ====================================================== */

  .tl-add-button {
    width: 100%;

    min-height: 64px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 22px;

    border: 0;

    border-radius: 18px;

    background: var(--tl-green);

    color: white;

    font-family: inherit;

    font-size: 13px;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
      0 15px 35px rgba(23, 51, 48, .15);

    transition:
      transform .25s ease,
      box-shadow .25s ease,
      background .25s ease;
  }


  .tl-add-button:hover:not(:disabled) {
    transform: translateY(-3px);

    background: var(--tl-green-light);

    box-shadow:
      0 20px 45px rgba(23, 51, 48, .20);
  }


  .tl-add-button:disabled {
    cursor: not-allowed;

    opacity: .45;
  }


  .tl-arrow {
    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    background: rgba(255,255,255,.12);

    border-radius: 50%;

    font-size: 16px;
  }


  .tl-secure-note {
    display: flex;

    justify-content: center;

    align-items: center;

    gap: 7px;

    margin-top: 13px;

    color: var(--tl-muted);

    font-size: 9px;

    letter-spacing: .2px;
  }


  .tl-secure-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--tl-sage);
  }


  /* =====================================================
     TRUST SECTION
  ====================================================== */

  .tl-trust-section {
    padding: 105px 0;

    background: white;
  }


  .tl-section-kicker {
    color: var(--tl-sage);

    font-size: 10px;

    font-weight: 800;

