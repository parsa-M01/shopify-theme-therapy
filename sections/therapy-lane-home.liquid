  <script>
    (function () {

      const root = document.getElementById(
        "therapy-lane-{{ section.id }}"
      );

      if (!root) return;

      const questions = root.querySelectorAll(".tl-faq-q");

      questions.forEach(function (button) {

        button.addEventListener("click", function () {

          const item =
            button.closest(".tl-faq-item");

          root
            .querySelectorAll(".tl-faq-item")
            .forEach(function (other) {

              if (other !== item) {
                other.classList.remove("open");
              }

            });

          item.classList.toggle("open");

        });

      });

    })();
  </script>


