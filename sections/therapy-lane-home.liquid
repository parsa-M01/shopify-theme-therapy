{% liquid
  assign standard_product = section.settings.standard_product
  assign experienced_product = section.settings.experienced_product
%}

<section class="therapy-lane" id="therapy-lane-{{ section.id }}">

  <style>
    #therapy-lane-{{ section.id }} {
      --tl-green: #173330;
      --tl-green-light: #234944;
      --tl-sage: #8eafa2;
      --tl-mint: #dcebe4;
      --tl-cream: #faf8f1;
      --tl-orange: #f2ad68;
      --tl-white: #ffffff;
      --tl-muted: #6d7d79;
      --tl-line: rgba(23,51,48,.12);

      background: var(--tl-cream);
      color: var(--tl-green);
      font-family: "DM Sans", sans-serif;
      overflow: hidden;
    }

    #therapy-lane-{{ section.id }},
    #therapy-lane-{{ section.id }} * {
      box-sizing: border-box;
    }

    #therapy-lane-{{ section.id }} a {
      color: inherit;
      text-decoration: none;
    }

    #therapy-lane-{{ section.id }} button {
      font: inherit;
    }

    #therapy-lane-{{ section.id }} .tl-container {
      width: min(1120px, calc(100% - 32px));
      margin: auto;
    }

    /* =========================
       HEADER
    ========================= */

    #therapy-lane-{{ section.id }} .tl-header {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 20;
      padding: 15px 0;
    }

    #therapy-lane-{{ section.id }} .tl-nav {
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8px 0 18px;

      background: rgba(250,248,241,.78);
      border: 1px solid rgba(255,255,255,.38);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-radius: 100px;

      box-shadow: 0 10px 30px rgba(23,51,48,.06);
    }

    #therapy-lane-{{ section.id }} .tl-logo {
      font-family: "Manrope", sans-serif;
      font-size: 19px;
      font-weight: 800;
      letter-spacing: .2px;
    }

    #therapy-lane-{{ section.id }} .tl-logo span {
      color: #789c8c;
    }

    #therapy-lane-{{ section.id }} .tl-nav-links {
      display: none;
    }

    #therapy-lane-{{ section.id }} .tl-nav-btn {
      background: var(--tl-green);
      color: white;
      padding: 11px 16px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
    }

    /* =========================
       HERO
    ========================= */

    #therapy-lane-{{ section.id }} .tl-hero {
      position: relative;
      min-height: 760px;

      display: flex;
      align-items: center;

      padding: 105px 0 45px;

      overflow: hidden;

      background:
        linear-gradient(
          180deg,
          rgba(23,51,48,.18),
          rgba(23,51,48,.68)
        ),
        {% if section.settings.hero_image != blank %}
          url("{{ section.settings.hero_image | image_url: width: 2400 }}")
        {% else %}
          url("https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=2000&q=88")
        {% endif %}
        center center / cover no-repeat;
    }

    #therapy-lane-{{ section.id }} .tl-hero::before {
      content: "";
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          circle at 82% 18%,
          rgba(242,173,104,.35),
          transparent 27%
        ),
        radial-gradient(
          circle at 10% 85%,
          rgba(220,235,228,.25),
          transparent 32%
        );
    }

    #therapy-lane-{{ section.id }} .tl-hero-inner {
      position: relative;
      z-index: 2;
      color: white;
    }

    #therapy-lane-{{ section.id }} .tl-hero-content {
      max-width: 760px;
    }

    #therapy-lane-{{ section.id }} .tl-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 8px 13px;

      border: 1px solid rgba(255,255,255,.32);
      background: rgba(255,255,255,.12);

      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);

      border-radius: 100px;

      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.8px;
    }

    #therapy-lane-{{ section.id }} .tl-eyebrow i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #b9d5c8;
      box-shadow: 0 0 0 5px rgba(185,213,200,.15);
    }

    #therapy-lane-{{ section.id }} .tl-hero h1 {
      margin: 24px 0;

      font-family: "Manrope", sans-serif;
      font-size: clamp(48px, 14vw, 92px);
      font-weight: 800;
      line-height: .98;
      letter-spacing: -2px;
    }

    #therapy-lane-{{ section.id }} .tl-hero h1 span {
      color: #d8ebe3;
    }

    #therapy-lane-{{ section.id }} .tl-hero-copy {
      max-width: 510px;

      color: rgba(255,255,255,.82);

      font-size: 15px;
      line-height: 1.75;
      letter-spacing: .25px;
    }

    #therapy-lane-{{ section.id }} .tl-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 27px;
    }

    #therapy-lane-{{ section.id }} .tl-btn {
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;

      padding: 0 21px;

      border-radius: 100px;

      font-size: 13px;
      font-weight: 700;

      transition:
        transform .25s ease,
        box-shadow .25s ease;
    }

    #therapy-lane-{{ section.id }} .tl-btn:hover {
      transform: translateY(-2px);
    }

    #therapy-lane-{{ section.id }} .tl-btn-white {
      background: white;
      color: var(--tl-green);
    }

    #therapy-lane-{{ section.id }} .tl-btn-glass {
      color: white;

      background: rgba(255,255,255,.12);

      border: 1px solid rgba(255,255,255,.3);

      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    #therapy-lane-{{ section.id }} .tl-hero-note {
      margin-top: 28px;

      color: rgba(255,255,255,.65);

      font-size: 11px;
      letter-spacing: .35px;
    }

    #therapy-lane-{{ section.id }} .tl-floating-card {
      display: none;

      position: absolute;

      right: 6%;
      bottom: 8%;

      width: 220px;

      padding: 18px;

      background: rgba(255,255,255,.9);
      color: var(--tl-green);

      border-radius: 22px;

      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);

      box-shadow: 0 20px 50px rgba(0,0,0,.18);
    }

    #therapy-lane-{{ section.id }} .tl-floating-card strong {
      display: block;

      font-family: "Manrope", sans-serif;
      font-size: 20px;

      letter-spacing: .3px;
    }

    #therapy-lane-{{ section.id }} .tl-floating-card small {
      display: block;

      margin-top: 6px;

      color: var(--tl-muted);

      font-size: 10px;
      line-height: 1.55;
    }

    /* =========================
       GENERAL HEADINGS
    ========================= */

    #therapy-lane-{{ section.id }} .tl-kicker {
      color: #789c8c;

      font-size: 10px;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 2px;
    }

    #therapy-lane-{{ section.id }} .tl-intro h2,
    #therapy-lane-{{ section.id }} .tl-plans h2,
    #therapy-lane-{{ section.id }} .tl-how h2,
    #therapy-lane-{{ section.id }} .tl-faq h2 {
      margin-top: 13px;

      font-family: "Manrope", sans-serif;
      font-size: clamp(35px, 9vw, 60px);
      font-weight: 800;
      line-height: 1.02;
      letter-spacing: -1.1px;
    }

    /* =========================
       INTRO
    ========================= */

    #therapy-lane-{{ section.id }} .tl-intro {
      padding: 85px 0;
    }

    #therapy-lane-{{ section.id }} .tl-intro h2 {
      max-width: 720px;
    }

    #therapy-lane-{{ section.id }} .tl-intro h2 span {
      color: #88a99c;
    }

    #therapy-lane-{{ section.id }} .tl-intro-grid {
      display: grid;
      gap: 30px;
      margin-top: 36px;
    }

    #therapy-lane-{{ section.id }} .tl-intro-copy {
      max-width: 520px;

      color: var(--tl-muted);

      font-size: 15px;
      line-height: 1.8;
      letter-spacing: .15px;
    }

    #therapy-lane-{{ section.id }} .tl-mini-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    #therapy-lane-{{ section.id }} .tl-stat {
      padding: 20px;

      background: white;

      border: 1px solid var(--tl-line);

      border-radius: 20px;
    }

    #therapy-lane-{{ section.id }} .tl-stat b {
      display: block;

      font-family: "Manrope", sans-serif;
      font-size: 27px;
      font-weight: 800;

      letter-spacing: .2px;
    }

    #therapy-lane-{{ section.id }} .tl-stat small {
      color: var(--tl-muted);
      font-size: 10px;
    }

    /* =========================
       PLANS
    ========================= */

    #therapy-lane-{{ section.id }} .tl-plans {
      padding: 10px 0 95px;
    }

    #therapy-lane-{{ section.id }} .tl-plans-head {
      margin-bottom: 30px;
    }

    #therapy-lane-{{ section.id }} .tl-plans-head p {
      max-width: 500px;

      margin-top: 16px;

      color: var(--tl-muted);

      font-size: 13px;
      line-height: 1.7;
      letter-spacing: .15px;
    }

    #therapy-lane-{{ section.id }} .tl-product-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #therapy-lane-{{ section.id }} .tl-product {
      width: 100%;

      min-height: 395px;

      display: flex;
      flex-direction: column;

      padding: 25px;

      background: white;

      border: 1px solid var(--tl-line);
      border-radius: 28px;

      box-shadow: 0 15px 45px rgba(23,51,48,.05);

      transition:
        transform .3s ease,
        box-shadow .3s ease;
    }

    #therapy-lane-{{ section.id }} .tl-product:hover {
      transform: translateY(-4px);

      box-shadow: 0 24px 60px rgba(23,51,48,.09);
    }

    #therapy-lane-{{ section.id }} .tl-product.tl-dark {
      background: var(--tl-green);
      color: white;
    }

    #therapy-lane-{{ section.id }} .tl-product-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    #therapy-lane-{{ section.id }} .tl-product-number {
      font-size: 10px;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 1.7px;

      opacity: .55;
    }

    #therapy-lane-{{ section.id }} .tl-badge {
      padding: 6px 10px;

      background: var(--tl-orange);
      color: var(--tl-green);

      border-radius: 100px;

      font-size: 9px;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: .7px;
    }

    #therapy-lane-{{ section.id }} .tl-product h3 {
      margin: 26px 0 10px;

      font-family: "Manrope", sans-serif;
      font-size: 28px;
      font-weight: 800;

      line-height: 1.08;
      letter-spacing: -.5px;
    }

    #therapy-lane-{{ section.id }} .tl-product p {
      max-width: 320px;

      color: var(--tl-muted);

      font-size: 13px;
      line-height: 1.7;
      letter-spacing: .1px;
    }

    #therapy-lane-{{ section.id }} .tl-product.tl-dark p {
      color: rgba(255,255,255,.64);
    }

    #therapy-lane-{{ section.id }} .tl-price {
      margin-top: auto;

      font-family: "Manrope", sans-serif;
      font-size: 43px;
      font-weight: 800;

      letter-spacing: -1px;
    }

    #therapy-lane-{{ section.id }} .tl-price small {
      font-family: "DM Sans", sans-serif;

      font-size: 11px;
      font-weight: 500;

      letter-spacing: .1px;

      opacity: .55;
    }

    #therapy-lane-{{ section.id }} .tl-product-list {
      display: grid;
      gap: 9px;

      margin: 18px 0 23px;

      list-style: none;
      padding: 0;
    }

    #therapy-lane-{{ section.id }} .tl-product-list li {
      display: flex;
      align-items: center;
      gap: 8px;

      font-size: 11px;
    }

    #therapy-lane-{{ section.id }} .tl-check {
      width: 17px;
      height: 17px;

      flex: none;

      display: grid;
      place-items: center;

      background: var(--tl-mint);
      color: var(--tl-green);

      border-radius: 50%;

      font-size: 9px;
      font-weight: 900;
    }

    #therapy-lane-{{ section.id }} .tl-product .tl-btn {
      width: 100%;
    }

    #therapy-lane-{{ section.id }} .tl-btn-dark {
      background: var(--tl-green);
      color: white;
    }

    #therapy-lane-{{ section.id }} .tl-product.tl-dark .tl-btn-dark {
      background: white;
      color: var(--tl-green);
    }

    /* =========================
       HOW IT WORKS
    ========================= */

    #therapy-lane-{{ section.id }} .tl-how {
      padding: 85px 0;
      background: var(--tl-mint);
    }

    #therapy-lane-{{ section.id }} .tl-steps {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 32px;
    }

    #therapy-lane-{{ section.id }} .tl-step {
      min-height: 190px;

      padding: 24px;

      background: rgba(255,255,255,.68);

      border: 1px solid rgba(23,51,48,.08);

      border-radius: 24px;
    }

    #therapy-lane-{{ section.id }} .tl-step-number {
      font-family: "Manrope", sans-serif;
      font-size: 11px;
      font-weight: 700;

      letter-spacing: 1px;

      opacity: .4;
    }

    #therapy-lane-{{ section.id }} .tl-step h3 {
      margin: 35px 0 8px;

      font-family: "Manrope", sans-serif;
      font-size: 21px;
      font-weight: 700;

      letter-spacing: .1px;
    }

    #therapy-lane-{{ section.id }} .tl-step p {
      color: var(--tl-muted);

      font-size: 12px;
      line-height: 1.75;
    }

    /* =========================
       FAQ
    ========================= */

    #therapy-lane-{{ section.id }} .tl-faq {
      padding: 85px 0;
    }

    #therapy-lane-{{ section.id }} .tl-faq-list {
      margin-top: 31px;
      border-top: 1px solid var(--tl-line);
    }

    #therapy-lane-{{ section.id }} .tl-faq-item {
      border-bottom: 1px solid var(--tl-line);
    }

    #therapy-lane-{{ section.id }} .tl-faq-q {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 22px 0;

      background: none;
      border: 0;

      color: var(--tl-green);

      text-align: left;

      font-size: 14px;
      font-weight: 700;

      letter-spacing: .15px;

      cursor: pointer;
    }

    #therapy-lane-{{ section.id }} .tl-plus {
      font-size: 21px;
      font-weight: 400;

      transition: .25s;
    }

    #therapy-lane-{{ section.id }} .tl-faq-a {
      max-height: 0;
      overflow: hidden;

      color: var(--tl-muted);

      font-size: 12px;
      line-height: 1.75;

      transition:
        max-height .3s ease,
        padding .3s ease;
    }

    #therapy-lane-{{ section.id }} .tl-faq-item.open .tl-faq-a {
      max-height: 150px;
      padding-bottom: 21px;
    }

    #therapy-lane-{{ section.id }} .tl-faq-item.open .tl-plus {
      transform: rotate(45deg);
    }

    /* =========================
       FINAL CTA
    ========================= */

    #therapy-lane-{{ section.id }} .tl-final {
      margin: 0 16px 16px;

      padding: 68px 22px;

      background:
        radial-gradient(
          circle at 85% 15%,
          rgba(142,175,162,.72),
          transparent 25%
        ),
        radial-gradient(
          circle at 10% 100%,
          rgba(242,173,104,.65),
          transparent 26%
        ),
        var(--tl-green);

      color: white;

      border-radius: 32px;

      text-align: center;
    }

    #therapy-lane-{{ section.id }} .tl-final h2 {
      max-width: 720px;

      margin: auto;

      font-family: "Manrope", sans-serif;
      font-size: clamp(37px,10vw,64px);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -.8px;
    }

    #therapy-lane-{{ section.id }} .tl-final p {
      max-width: 440px;

      margin: 17px auto 0;

      color: rgba(255,255,255,.64);

      font-size: 13px;
      line-height: 1.7;
    }

    #therapy-lane-{{ section.id }} .tl-final .tl-btn {
      margin-top: 26px;
    }

    /* =========================
       FOOTER
    ========================= */

    #therapy-lane-{{ section.id }} .tl-footer {
      padding: 36px 16px;
      text-align: center;
    }

    #therapy-lane-{{ section.id }} .tl-footer-logo {
      font-family: "Manrope", sans-serif;
      font-size: 19px;
      font-weight: 800;
      letter-spacing: .2px;
    }

    #therapy-lane-{{ section.id }} .tl-footer-logo span {
      color: #789c8c;
    }

    #therapy-lane-{{ section.id }} .tl-footer p {
      margin-top: 8px;

      color: var(--tl-muted);

      font-size: 10px;
    }

    #therapy-lane-{{ section.id }} .tl-footer-links {
      display: flex;
      justify-content: center;
      gap: 21px;

      margin-top: 18px;

      color: var(--tl-muted);

      font-size: 10px;
    }

    /* =========================
       DESKTOP
    ========================= */

    @media (min-width: 760px) {

      #therapy-lane-{{ section.id }} .tl-container {
        width: min(1120px, calc(100% - 60px));
      }

      #therapy-lane-{{ section.id }} .tl-header {
        padding-top: 22px;
      }

      #therapy-lane-{{ section.id }} .tl-nav {
        height: 64px;
      }

      #therapy-lane-{{ section.id }} .tl-nav-links {
        display: flex;

        gap: 30px;

        margin-left: auto;
        margin-right: 30px;

        color: var(--tl-muted);

        font-size: 12px;
        font-weight: 600;

        letter-spacing: .15px;
      }

      #therapy-lane-{{ section.id }} .tl-hero {
        min-height: 820px;
      }

      #therapy-lane-{{ section.id }} .tl-hero-content {
        max-width: 790px;
      }

      #therapy-lane-{{ section.id }} .tl-floating-card {
        display: block;
      }

      #therapy-lane-{{ section.id }} .tl-intro {
        padding: 110px 0;
      }

      #therapy-lane-{{ section.id }} .tl-intro-grid {
        grid-template-columns: 1fr .75fr;
        align-items: end;
      }

      #therapy-lane-{{ section.id }} .tl-product-grid {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      #therapy-lane-{{ section.id }} .tl-product {
        min-height: 420px;
      }

      #therapy-lane-{{ section.id }} .tl-how {
        padding: 110px 0;
      }

      #therapy-lane-{{ section.id }} .tl-steps {
        grid-template-columns: repeat(3,1fr);
      }

      #therapy-lane-{{ section.id }} .tl-step {
        min-height: 225px;
      }

      #therapy-lane-{{ section.id }} .tl-faq {
        padding: 110px 0;
      }

      #therapy-lane-{{ section.id }} .tl-final {
        margin: 0 30px 30px;
        padding: 105px 30px;
        border-radius: 42px;
      }
    }

    @media (min-width: 1050px) {

      #therapy-lane-{{ section.id }} .tl-hero {
        min-height: 850px;
      }

      #therapy-lane-{{ section.id }} .tl-hero h1 {
        font-size: 88px;
        letter-spacing: -1.5px;
      }
    }

    @media (max-width: 390px) {

      #therapy-lane-{{ section.id }} .tl-container {
        width: calc(100% - 24px);
      }

      #therapy-lane-{{ section.id }} .tl-nav {
        padding-left: 14px;
      }

      #therapy-lane-{{ section.id }} .tl-logo {
        font-size: 17px;
      }

      #therapy-lane-{{ section.id }} .tl-nav-btn {
        padding: 10px 13px;
        font-size: 11px;
      }

      #therapy-lane-{{ section.id }} .tl-hero {
        min-height: 720px;
      }

      #therapy-lane-{{ section.id }} .tl-hero h1 {
        font-size: 47px;
        letter-spacing: -1.3px;
      }

      #therapy-lane-{{ section.id }} .tl-hero-actions {
        flex-direction: column;
      }

      #therapy-lane-{{ section.id }} .tl-hero-actions .tl-btn {
        width: 100%;
      }

      #therapy-lane-{{ section.id }} .tl-product {
        padding: 22px;
        border-radius: 25px;
      }

      #therapy-lane-{{ section.id }} .tl-product h3 {
        font-size: 25px;
      }

      #therapy-lane-{{ section.id }} .tl-price {
        font-size: 39px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #therapy-lane-{{ section.id }} *,
      #therapy-lane-{{ section.id }} *::before,
      #therapy-lane-{{ section.id }} *::after {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>

  <!-- HEADER -->

  <header class="tl-header">
    <div class="tl-container">

      <nav class="tl-nav">

        <a href="{{ routes.root_url }}" class="tl-logo">
          therapy<span>lane</span>
        </a>

        <div class="tl-nav-links">
          <a href="#tl-plans-{{ section.id }}">Therapists</a>
          <a href="#tl-how-{{ section.id }}">How it works</a>
          <a href="#tl-faq-{{ section.id }}">FAQ</a>
        </div>

        <a href="#tl-plans-{{ section.id }}" class="tl-nav-btn">
          Find your therapist
        </a>

      </nav>

    </div>
  </header>


  <!-- HERO -->

  <section class="tl-hero">

    <div class="tl-container tl-hero-inner">

      <div class="tl-hero-content">

        <h1>
          Screw AI.<br>
          <span>Talk to a human.</span>
        </h1>

        <p class="tl-hero-copy">
          Real therapists. Accessible prices. No bots.
          Talk to someone qualified, present,
          and genuinely human.
        </p>

        <div class="tl-hero-actions">

          <a
            href="#tl-plans-{{ section.id }}"
